/* Conversation/workbench layout with semantic colors from the current theme. */
Screen {
    background: $background;
    color: $text;
    border: round $frame-border;
}
#app-header { dock: top; height: 6; }
#title-bar {
    height: 3;
    padding: 0 2;
    content-align: left middle;
    background: $panel;
    border-bottom: solid $frame-border;
}
#workspace-bar {
    height: 3;
    padding: 0 2;
    border-bottom: solid $frame-border;
    align-vertical: middle;
}
#workspace-label { width: 1fr; height: 1; color: $text-muted; }
#model-label { width: auto; max-width: 40%; height: 1; text-align: right; color: $text; }
#provider-select { height: 1fr; align: center middle; }
#select-label { height: auto; text-align: center; text-style: bold; }
#provider-list { width: 90%; max-width: 70; height: auto; max-height: 16; margin: 1; }
#conversation-layout { height: 1fr; min-height: 1; }
#chat-area { width: 1fr; height: 1fr; min-height: 1; padding: 1 2; }
.message { width: 100%; height: auto; padding: 0; }
.user-row, .ai-row { width: 100%; height: auto; }
.user-row { margin-bottom: 1; }
.user-message { color: $text; background: $user-surface; border-left: solid $primary; padding: 1 2; }
.ai-row { margin-bottom: 1; }
.assistant-label { height: 1; color: $primary; margin-bottom: 1; }
.ai-message { color: $text; padding: 0; margin: 0 0 1 0; }
.error-message { color: $error; padding: 0 1; }
.system-message { color: $text-muted; padding: 0 1; }
.tool-block {
    width: 100%; height: auto; padding: 0 1; margin-bottom: 1;
    color: $text; border-left: solid $frame-border;
}
.tool-block-loading { color: $text-muted; }
.tool-block-error { color: $error; }
.tool-block:focus { background: $surface; border-left: solid $primary; }
.subagent-block, .thinking-done { height: auto; color: $text-muted; }
#input-area { dock: bottom; height: auto; max-height: 70%; padding: 0 2; }
#run-status { height: 1; color: $text-muted; margin-bottom: 1; }
#latest-link { height: 1; display: none; color: $primary; }
#composer {
    height: auto; background: $composer-surface; border: round $primary; padding: 0 1;
}
#composer-label { height: 1; color: $text-muted; }
#chat-input {
    height: auto; min-height: 3; max-height: 6;
    border: none; padding: 0; color: $text; background: $composer-surface;
}
#chat-input:focus { border: none; }
#chat-input .text-area--cursor-line { background: $composer-surface; }
#chat-input .text-area--placeholder { color: $text-muted; }
#chat-input .text-area--selection { background: $user-surface; color: $text; }
#key-hints { height: 1; color: $text-muted; }
#status-bar { height: 1; width: 100%; border: none; margin-top: 1; }
#mode-label, #teammates-label { width: auto; height: 1; padding-right: 2; color: $text-muted; }
#mcp-label { width: 1fr; height: 1; color: $text-muted; }
#context-label { width: auto; height: 1; text-align: right; color: $text-muted; }
#teammate-tree { height: auto; padding: 0 1; }
#details-panel {
    display: none; width: 39%; height: 1fr; background: $panel;
    border-left: solid $frame-border; padding: 1 1 0 1;
}
#details-title { height: 1; margin-bottom: 1; color: $text; }
#task-facts { height: auto; max-height: 8; margin-bottom: 1; color: $text-muted; }
#details-panel TabbedContent, #details-panel ContentSwitcher { height: 1fr; }
#details-panel TabPane { height: 1fr; padding: 0; }
#changes-scroll, #execution-scroll { height: 1fr; }
#workspace-changes, #execution-facts, #execution-records { height: auto; }
#execution-facts { margin-bottom: 1; color: $text-muted; }
#git-actions { height: 3; }
#git-actions Button { min-width: 8; width: 1fr; }
#details-footer { dock: bottom; height: 1; color: $text-muted; }
Screen.details-full #details-panel { width: 100%; }
CompletionPopup { max-height: 4; background: $surface; color: $text; }
#perm-inline, #askuser-inline, #plan-inline, #resume-inline {
    height: auto; border-left: solid $warning; padding: 0 1;
}
#perm-feedback { height: 3; margin: 0; background: $surface; }
#perm-content, #askuser-content, #plan-content, #resume-content { height: auto; }
PlanApprovalDialog, AskUserDialog { align: center middle; }
#plan-dialog, #askuser-dialog {
    width: 64; max-width: 95%; height: auto; max-height: 90%;
    padding: 1 2; background: $surface; border: solid $primary;
}
#plan-title, #askuser-title { text-style: bold; text-align: center; padding-bottom: 1; }
#plan-dialog Button { width: 100%; margin-bottom: 1; }
#askuser-options { height: auto; max-height: 12; }
/* Keep the same hierarchy in short terminals, shrinking decoration before content. */
Screen.compact { border: none; }
Screen.compact #app-header { height: 3; }
Screen.compact #title-bar { height: 1; padding: 0 1; border: none; }
Screen.compact #workspace-bar { height: 2; padding: 0 1; }
Screen.compact #chat-area { padding: 0 1; }
Screen.compact #input-area { padding: 0 1; }
Screen.compact #composer-label, Screen.compact #key-hints { display: none; }
Screen.compact #chat-input { min-height: 1; max-height: 3; }
Screen.compact #run-status { margin-bottom: 0; }
Screen.compact #status-bar { margin-top: 0; }
Screen.compact #details-panel { padding: 0 1; }
Screen.compact #details-title { margin-bottom: 0; }
Screen.compact #task-facts { max-height: 2; margin-bottom: 0; }
Screen.compact .assistant-label { margin-bottom: 0; }
Screen.compact CompletionPopup { max-height: 3; }
